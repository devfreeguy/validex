# Dependencies – rebuilt inside the image
node_modules/
**/node_modules/
.pnpm-store/

# Build artifacts – produced inside the image
dist/
build/
.next/
out/
apps/api/dist/
apps/web/.next/

# Prisma generated client – regenerated inside the image
**/src/generated/

# Environment – NEVER bake secrets into the image
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Git
.git/
.gitignore
.github/

# Tests & coverage
coverage/
**/*.spec.ts
**/*.test.ts

# TypeScript build info
*.tsbuildinfo
.turbo/

# Web app – not built in this Dockerfile, but package.json needed for workspace graph
apps/web/**
!apps/web/package.json

# Render-specific / OCI deploy tooling – not part of the build context
render.yaml
deploy/
