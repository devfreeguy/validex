# Validex API - production environment
#
# Copy to /opt/apps/validex/.env and fill in real values. This file is
# consumed by `docker compose --env-file` / `docker run --env-file`, which
# treats quotes as LITERAL characters (not shell quoting) - do NOT wrap any
# value below in quotes, or it will end up embedded in the string the app
# reads via process.env.

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# Must match deploy/compose.yml's port mapping (127.0.0.1:3003:3003) and the
# Caddy reverse_proxy target (127.0.0.1:3003) in deploy/README.md - changing
# this without updating both leaves the app listening on a port nothing
# forwards to. Not the same as the repo root .env.example's PORT=5000,
# which is only for local dev alongside the web app on :3000 - copy THIS
# file for the production .env, not the root one.
PORT=3003
ALGORITHM_VERSION=REPLACE_ME

# ── Network ──────────────────────────────────────────────────────────────
# testnet or mainnet - only the matching ALGO_<NETWORK>_* block below is
# required by env.validation.ts; the other network's vars can stay blank.
NETWORK=testnet

# Algorand Testnet
ALGO_TESTNET_WALLET_ADDRESS=REPLACE_ME
ALGO_TESTNET_USDC_ASSET_ID=10458941
ALGO_TESTNET_FACILITATOR_URL=https://facilitator.goplausible.xyz

# Algorand Mainnet (only required when NETWORK=mainnet)
# ALGO_MAINNET_WALLET_ADDRESS=REPLACE_ME
# ALGO_MAINNET_USDC_ASSET_ID=31566704
# ALGO_MAINNET_FACILITATOR_URL=https://facilitator.goplausible.xyz

# ── GitHub ───────────────────────────────────────────────────────────────
GITHUB_TOKEN=REPLACE_ME

# ── Groq ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=REPLACE_ME
GROQ_MODEL=openai/gpt-oss-120b

# ── Database ─────────────────────────────────────────────────────────────
# This VM's shared `postgres` container has no PgBouncer and no separate
# direct-connection endpoint the way Neon did - DATABASE_URL (used by
# Prisma Client via @prisma/adapter-pg at runtime) and DATABASE_DIRECT_URL
# (used by `prisma migrate deploy` in the migrator container) point at the
# SAME host:port/database on purpose. Keep both in sync if this ever
# changes.
DATABASE_URL=postgresql://validex_user:REPLACE_ME@postgres:5432/validex_db
DATABASE_DIRECT_URL=postgresql://validex_user:REPLACE_ME@postgres:5432/validex_db

# ── Redis ────────────────────────────────────────────────────────────────
# Shared `redis` container, plaintext (no TLS) with requirepass - confirmed
# parseRedisUrl() only enables TLS for a rediss:// scheme, so redis:// here
# is correct and connects as plaintext.
REDIS_URL=redis://:REPLACE_ME@redis:6379
REDIS_KEY_PREFIX=validex:

# ── Playwright / Chromium ───────────────────────────────────────────────
# The image already sets this to its apt-installed Chromium's path
# (/usr/bin/chromium). Only set it here if you need to override the image's
# default - e.g. pointing at a different browser binary mounted into the
# container.
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
