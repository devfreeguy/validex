# App
NODE_ENV=development
# The API runs on 5000 so it doesn't collide with the Next.js web app's
# default dev port (3000, unset below).
PORT=5000
ALGORITHM_VERSION=1.0.0

# Network
NETWORK=testnet

# Algorand Mainnet
# Required: receive address must be opted into USDC on the selected network
ALGO_MAINNET_WALLET_ADDRESS=
ALGO_MAINNET_USDC_ASSET_ID=31566704
# Facilitator (GoPlausible)
ALGO_MAINNET_FACILITATOR_URL=https://facilitator.goplausible.xyz

# Algorand Testnet
# Required: receive address must be opted into USDC on the selected network
ALGO_TESTNET_WALLET_ADDRESS=
ALGO_TESTNET_USDC_ASSET_ID=10458941
# Facilitator (GoPlausible)
ALGO_TESTNET_FACILITATOR_URL=https://facilitator.goplausible.xyz

# GitHub
GITHUB_TOKEN=

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Database (Neon)
# DATABASE_URL = Neon pooled/pgbouncer connection string (used by Prisma Client at runtime)
# DATABASE_DIRECT_URL = Neon direct connection string (required for migrations, bypasses PgBouncer)
DATABASE_URL=
DATABASE_DIRECT_URL=

# Redis
REDIS_URL=

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:5000
# Public-facing URL of the web app - used for canonical URLs and OG metadata.
# Set this to the actual production domain on the server (https://validex.space).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Must match the API's own NETWORK - the wallet has to sign for the same
# network the server's x402 payment requirements are configured for.
NEXT_PUBLIC_NETWORK=testnet
